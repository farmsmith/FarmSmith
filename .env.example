# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.

# --- Supabase ---
# Project URL and Publishable key: Settings > API Keys (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key: Settings > API Keys — SERVER ONLY, never expose to the browser
SUPABASE_SECRET_KEY=

# --- Razorpay ---
# Key ID is safe to expose to the browser (used to open the checkout widget)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Key Secret and Webhook Secret — SERVER ONLY
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- FarmSmith tax jurisdiction ---
# Used for CGST/SGST vs IGST calculation. Default: Tamil Nadu
FARM_SMITH_STATE=Tamil Nadu

# --- Shiprocket Shipping Integration ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=

